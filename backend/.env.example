# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production

# Database
DATABASE_URL=postgresql://timeliner:password@localhost:5432/timeliner_db

# Redis (for Celery & Caching)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# CORS (Frontend URL)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# File Upload
MAX_CONTENT_LENGTH=104857600  # 100MB in bytes
UPLOAD_FOLDER=./uploads

# JWT Configuration
JWT_ACCESS_TOKEN_EXPIRES=3600  # 1 hour
JWT_REFRESH_TOKEN_EXPIRES=2592000  # 30 days

# Application Settings
ITEMS_PER_PAGE=50
MAX_SEARCH_RESULTS=1000

# Encryption Key for API Keys (REQUIRED)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANT: Keep this secret! If you change it, all encrypted API keys become unreadable.
ENCRYPTION_KEY=generate-and-paste-your-key-here
